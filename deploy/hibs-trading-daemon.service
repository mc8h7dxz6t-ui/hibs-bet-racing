# Racing liquidity routing / trading daemon — canonical unit lives in hibs-bet.
# apply-trading-daemon.sh installs deploy/systemd/hibs-trading-daemon.service from hibs-bet when present.
#
# Fallback copy (keep in sync with /opt/hibs-bet/deploy/systemd/hibs-trading-daemon.service):

[Unit]
Description=HIBS racing trading daemon (liquidity routing sandbox)
After=network-online.target redis-server.service hibs-racing.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=hibs_executor
Group=hibs_executor
WorkingDirectory=/opt/hibs-racing
RuntimeDirectory=hibs
RuntimeDirectoryMode=2770
UMask=0007
Environment=HOME=/opt/hibs-racing
Environment=PYTHONPATH=/opt/hibs-racing/src
Environment=HIBS_TRADING_STATUS_FILE=/var/run/hibs/trading_daemon.json
Environment=HIBS_RACING_FORCE_DISK=1
Environment=HIBS_RACING_DB_PATH=/opt/hibs-racing/data/feature_store.sqlite
Environment=HIBS_RACING_DATA_DIR=/opt/hibs-racing/data
EnvironmentFile=-/opt/hibs-racing/.env
ExecStartPre=/bin/mkdir -p /var/run/hibs /opt/hibs-racing/data
ExecStartPre=/bin/chown hibs_executor:hibs-shared /var/run/hibs
ExecStartPre=/bin/chmod 2770 /var/run/hibs
ExecStart=/opt/hibs-racing/.venv/bin/hibs-racing trading-daemon
CPUAffinity=2 3
Restart=on-failure
RestartSec=15
ReadWritePaths=/opt/hibs-racing /var/run/hibs

[Install]
WantedBy=multi-user.target
